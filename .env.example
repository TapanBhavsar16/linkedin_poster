# Copy to .env and add your key. Never commit the real .env file.
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openrouter/free
PAPER_LIMIT=5

# LinkedIn OAuth application settings.
CLIENT_ID=your-linkedin-client-id
CLIENT_SECRET=your-linkedin-client-secret
REDIRECT_URI=http://localhost:8000/callback
LINKEDIN_USERNAME=your-linkedin-email
LINKEDIN_PASSWORD=your-linkedin-password
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_VERSION=202511

# The final graph node publishes only when explicitly enabled.
LINKEDIN_PUBLISH=false
# Set true for unattended OAuth/browser execution when a valid token is available.
LINKEDIN_HEADLESS=false
