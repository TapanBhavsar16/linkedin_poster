# Copy to .env and add your key. Never commit the real .env file.
# OpenRouter configuration (used directly by litellm)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openrouter/free
# Per-request OpenRouter timeout and SDK retry count. The LangGraph node has
# its own retry policy too.
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_MAX_RETRIES=2
PAPER_LIMIT=5
# Research providers. Set any value to false to skip that source.
ENABLE_ARXIV=true
ENABLE_HUGGING_FACE=true
ENABLE_OPENALEX=true
# Large PDFs are summarized hierarchically before the post-planning call.
PDF_MAP_CHUNK_TOKENS=6000
PDF_MAP_CHUNK_OVERLAP_TOKENS=200
PDF_REDUCE_INPUT_TOKENS=12000
PDF_SUMMARY_MAX_OUTPUT_TOKENS=1200
# Set true only when tiktoken's encoding data is already locally cached.
PDF_USE_TIKTOKEN=false
# Extracted-paper and summary text is logged in truncated form for debugging.
PDF_LOG_TEXT_MAX_CHARS=1000
DAILY_QUERY=AI research

# LinkedIn OAuth application settings.
CLIENT_ID=your-linkedin-client-id
CLIENT_SECRET=your-linkedin-client-secret
REDIRECT_URI=http://localhost:8000/callback
LINKEDIN_USERNAME=your-linkedin-email
LINKEDIN_PASSWORD=your-linkedin-password
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_VERSION=202511

# The final graph node publishes only when explicitly enabled.
LINKEDIN_PUBLISH=false
# Set true for unattended OAuth/browser execution when a valid token is available.
LINKEDIN_HEADLESS=false
